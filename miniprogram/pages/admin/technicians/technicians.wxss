/* pages/admin/technicians/technicians.wxss */
.head-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
  padding: 0 4rpx;
}
.head-tip { font-size: 25rpx; color: var(--ink-3); }

.t { display: flex; align-items: flex-start; }
.t-zi {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  flex-shrink: 0;
}
.t-avatar-img { background: #F0EDE4; }
.t-off { opacity: 0.4; }
.t-body { flex: 1; margin-left: 22rpx; min-width: 0; }
.t-row { display: flex; align-items: center; }
.t-name { font-size: 30rpx; font-weight: 600; margin-right: 16rpx; }
.t-title { margin-top: 6rpx; font-size: 23rpx; color: var(--ink-3); }
.t-tags { margin-top: 6rpx; font-size: 23rpx; color: var(--gold); }
.t-ops {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  margin-left: 12rpx;
  flex-shrink: 0;
  align-items: stretch;
}
.t-ops .btn-mini { width: 110rpx; }

.abk-pad { height: 160rpx; }

/* 弹层 */
.mask {
  position: fixed;
  inset: 0;
  background: rgba(59, 56, 48, 0.45);
  z-index: 30;
  display: flex;
  align-items: flex-end;
}
.sheet {
  width: 100%;
  background: var(--bg);
  border-radius: 32rpx 32rpx 0 0;
  padding: 36rpx 36rpx calc(36rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  max-height: 82vh;
  overflow-y: auto;
}
.sheet-title {
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  margin-bottom: 30rpx;
}
.sheet-ops { display: flex; align-items: center; margin-top: 36rpx; }
.sheet-cancel { width: 180rpx; padding: 16rpx 0; justify-content: center; }
.sheet-save { flex: 1; margin-left: 22rpx; }
