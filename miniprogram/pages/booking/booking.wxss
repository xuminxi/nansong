/* pages/booking/booking.wxss */
.bk { padding-bottom: 220rpx; }

/* 步骤条 */
.steps { display: flex; align-items: center; justify-content: center; padding: 16rpx 0 10rpx; }
.step { display: flex; align-items: center; font-size: 24rpx; color: var(--ink-2); letter-spacing: 2rpx; }
.step .s-num {
  font-size: 26rpx;
  color: var(--gold);
  margin-right: 8rpx;
  font-weight: 600;
}
.s-line { width: 44rpx; height: 1rpx; background: var(--line); margin: 0 14rpx; }

/* 项目横选 */
.pick-scroll { white-space: nowrap; }
.pick-card {
  position: relative;
  display: inline-block;
  width: 260rpx;
  background: var(--card);
  border: 2rpx solid var(--line);
  border-radius: var(--radius);
  padding: 24rpx;
  margin-right: 18rpx;
  box-sizing: border-box;
  vertical-align: top;
}
.pick-card.on { border-color: var(--green); background: #F4F8F3; }
.pick-name { font-size: 27rpx; font-weight: 600; }
.pick-meta { margin-top: 8rpx; font-size: 23rpx; color: var(--ink-2); }
.pick-check {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  font-size: 20rpx;
  color: var(--green);
}

/* 技师选择 */
.tech-row { display: flex; flex-wrap: wrap; }
.tech-pick {
  width: 150rpx;
  background: var(--card);
  border: 2rpx solid var(--line);
  border-radius: var(--radius);
  padding: 22rpx 0;
  text-align: center;
  margin: 0 18rpx 18rpx 0;
}
.tech-pick.on { border-color: var(--green); background: #F4F8F3; }
.tech-pick-zi {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 34rpx;
}
.tech-pick-zi.any { background: #D9D2C0; color: #6B6752; }
.tech-pick-name { margin-top: 12rpx; font-size: 25rpx; }

/* 日期 */
.day-scroll { white-space: nowrap; }
.day {
  display: inline-block;
  width: 110rpx;
  text-align: center;
  border: 2rpx solid var(--line);
  border-radius: 16rpx;
  padding: 14rpx 0;
  margin-right: 14rpx;
  background: #FCFAF4;
}
.day.on { border-color: var(--green); background: var(--green); color: #fff; }
.day-week { font-size: 22rpx; }
.day-num { font-size: 34rpx; font-weight: 600; margin-top: 2rpx; }
.day-month { font-size: 20rpx; opacity: 0.7; margin-top: 2rpx; }

/* 时段网格 */
.times { margin-top: 26rpx; display: flex; flex-wrap: wrap; }
.time {
  width: 150rpx;
  border: 1rpx solid var(--line);
  border-radius: 14rpx;
  text-align: center;
  padding: 14rpx 0;
  margin: 0 16rpx 16rpx 0;
  background: #FCFAF4;
}
.time-hm { font-size: 28rpx; font-weight: 500; }
.time-left { font-size: 20rpx; color: var(--ink-3); margin-top: 2rpx; }
.time.on { border-color: var(--green); background: var(--green-soft); }
.time.on .time-hm { color: var(--green-deep); }
.time.off { opacity: 0.42; background: #F4F1E9; }

/* 错误提示 */
.err { margin-top: 10rpx; font-size: 24rpx; color: var(--danger); }

.bk-pad { height: 40rpx; }

/* 底部摘要栏 */
.summary {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FFFFFF;
  border-top: 1rpx solid var(--line);
  padding: 20rpx 32rpx calc(20rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  z-index: 10;
}
.summary-info { flex: 1; min-width: 0; }
.summary-name { font-size: 27rpx; font-weight: 600; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.summary-detail { font-size: 22rpx; color: var(--ink-2); margin-top: 4rpx; }
.summary-price { margin: 0 20rpx; flex-shrink: 0; }
.submit { flex-shrink: 0; padding: 18rpx 40rpx; }

/* 指定技师（tech 模式锁定卡片） */
.tech-lock { display: flex; align-items: center; }
.tech-lock-zi { width: 96rpx; height: 96rpx; border-radius: 50%; flex-shrink: 0; font-size: 38rpx; }
.tech-lock-body { margin-left: 24rpx; }
.tech-lock-name { font-size: 32rpx; font-weight: 600; letter-spacing: 2rpx; }
.tech-lock-title { margin-top: 6rpx; font-size: 23rpx; color: var(--ink-3); }

/* quick 模式智能分配说明 */
.auto-card { font-size: 25rpx; }
.auto-row { display: flex; padding: 8rpx 0; }
.auto-k { width: 130rpx; color: var(--ink-3); flex-shrink: 0; }
.auto-v { color: var(--ink-2); flex: 1; }
.match-box {
  margin-top: 18rpx;
  border-top: 1rpx dashed var(--line);
  padding-top: 20rpx;
}
.match-label { font-size: 22rpx; color: var(--gold); letter-spacing: 2rpx; }
.match-val { margin-top: 10rpx; font-size: 30rpx; font-weight: 600; color: var(--green-deep); }
.match-use {
  margin-left: 20rpx;
  font-size: 24rpx;
  font-weight: 400;
  color: #fff;
  background: var(--green);
  border-radius: 999rpx;
  padding: 6rpx 26rpx;
}
.match-none { font-size: 24rpx; color: var(--ink-3); }

/* 时段格第二行（结束时间） */
.time-end { font-size: 19rpx; color: var(--ink-3); }
.time.on .time-end { color: var(--green); }
.times-tip {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: var(--ink-3);
  text-align: justify;
}

.times-loading { padding: 20rpx 0; font-size: 24rpx; color: var(--ink-3); text-align: center; }
