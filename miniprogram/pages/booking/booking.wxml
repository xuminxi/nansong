<!--pages/booking/booking.wxml — 预约下单（quick 自动匹配 / tech 指定技师）-->
<view class="page-pad bk">

  <!-- 步骤条 -->
  <view class="steps">
    <view class="step on"><text class="s-num">壹</text><text>选项目</text></view>
    <view class="s-line"></view>
    <view class="step on"><text class="s-num">贰</text><text>{{mode === 'tech' ? '指定技师' : '智能匹配'}}</text></view>
    <view class="s-line"></view>
    <view class="step on"><text class="s-num">叁</text><text>选时间</text></view>
    <view class="s-line"></view>
    <view class="step on"><text class="s-num">肆</text><text>确认</text></view>
  </view>

  <!-- 1 选项目 -->
  <view class="section-title">
    <view class="dot"></view>
    <text class="zh">选择项目</text>
  </view>
  <scroll-view scroll-x class="pick-scroll" enhanced show-scrollbar="{{false}}">
    <view class="pick-card {{serviceId === item.id ? 'on' : ''}}" wx:for="{{services}}" wx:key="id" data-id="{{item.id}}" bindtap="onService">
      <view class="pick-name">{{item.name}}</view>
      <view class="pick-meta">{{item.duration}}分钟 · ¥{{item.price}}</view>
      <view class="pick-check" wx:if="{{serviceId === item.id}}">已选</view>
    </view>
  </scroll-view>

  <!-- 2 技师 -->
  <view class="section-title">
    <view class="dot"></view>
    <text class="zh">{{mode === 'tech' ? '指定技师' : '技师分配'}}</text>
  </view>
  <!-- tech 模式：锁定技师卡片 -->
  <view class="card tech-lock" wx:if="{{mode === 'tech' && tech}}">
    <view class="zi-avatar tech-lock-zi" style="background:{{tech.color}}">{{tech.zi}}</view>
    <view class="tech-lock-body">
      <view class="tech-lock-name">{{tech.name}}</view>
      <view class="tech-lock-title">{{tech.title}}</view>
    </view>
  </view>
  <!-- quick 模式：智能分配说明 + 匹配结果 -->
  <view class="card auto-card" wx:else>
    <view class="auto-row"><text class="auto-k">分配方式</text><text class="auto-v">系统自动分配空闲技师</text></view>
    <view class="auto-row"><text class="auto-k">匹配规则</text><text class="auto-v">两位技师均空闲时随机分配，排班互不影响</text></view>
    <view class="match-box" wx:if="{{matchInfo}}">
      <view class="match-label">已为您匹配最近可约</view>
      <view class="match-val">
        {{matchInfo.week}} {{matchInfo.dateCN}} {{matchInfo.time}} - {{matchInfo.endTime}}
        <text class="match-use" bindtap="useMatch">选用</text>
      </view>
    </view>
    <view class="match-box match-none" wx:if="{{!matchInfo}}">
      未来 7 天暂无可约时段，可稍后再来
    </view>
  </view>

  <!-- 3 选日期时段 -->
  <view class="section-title" id="step-time">
    <view class="dot"></view>
    <text class="zh">选择时间</text>
  </view>
  <view class="card">
    <scroll-view scroll-x class="day-scroll" enhanced show-scrollbar="{{false}}">
      <view class="day {{date === item.date ? 'on' : ''}}" wx:for="{{days}}" wx:key="date" data-date="{{item.date}}" bindtap="onDay">
        <view class="day-week">{{item.week}}</view>
        <view class="day-num">{{item.day}}</view>
        <view class="day-month">{{item.month}}</view>
      </view>
    </scroll-view>
    <view class="times-loading" wx:if="{{loadingTimes}}">正在获取可约时段…</view>
    <view class="times">
      <view class="time {{item.disabled ? 'off' : ''}} {{time === item.time ? 'on' : ''}}"
            wx:for="{{times}}" wx:key="time"
            data-time="{{item.time}}" data-disabled="{{item.disabled}}" bindtap="onTime">
        <view class="time-hm">{{item.time}}</view>
        <view class="time-end">{{item.endTime}} 止</view>
        <view class="time-left">{{item.disabled ? '不可约' : (mode === 'quick' ? (item.freeCount > 1 ? '2位可约' : '可约') : '空闲')}}</view>
      </view>
    </view>
    <view class="times-tip" wx:if="{{mode === 'tech'}}">以上为 {{tech.name}} 的空闲开始时间，所选项目将占用 {{selService.duration}} 分钟</view>
    <view class="times-tip" wx:else>所选项目将占用 {{selService.duration}} 分钟；灰色时段为已约满或超营业时间</view>
  </view>

  <!-- 4 联系方式 -->
  <view class="section-title">
    <view class="dot"></view>
    <text class="zh">联系方式</text>
  </view>
  <view class="card">
    <view class="form-item">
      <text class="form-label">手机号（预约成功后自动记住，下次免填）</text>
      <input class="form-input" type="number" maxlength="11" placeholder="请输入 11 位手机号"
             value="{{phone}}" bindinput="onPhone" />
      <view class="err" wx:if="{{phoneError}}">{{phoneError}}</view>
    </view>
    <view class="form-item">
      <text class="form-label">备注（可选）</text>
      <textarea class="form-textarea" maxlength="100" placeholder="如：力道轻一些、腰不太好等"
                value="{{remark}}" bindinput="onRemark"></textarea>
    </view>
  </view>

  <view class="bk-pad"></view>

  <!-- 底部摘要栏 -->
  <view class="summary">
    <view class="summary-info" wx:if="{{selService}}">
      <view class="summary-name">{{selService.name}} · {{mode === 'tech' ? tech.name : '自动分配'}}</view>
      <view class="summary-detail">{{date}} {{time ? time + ' - ' + endTime : '未选时段'}} · 约 {{selService.duration}} 分钟</view>
    </view>
    <view class="summary-info" wx:else>
      <view class="summary-name">暂无可约项目</view>
    </view>
    <view class="summary-price price"><text class="unit">¥</text><text class="num">{{selService ? selService.price : '--'}}</text></view>
    <button class="btn btn-primary submit {{(selService && time && !submitting) ? '' : 'disabled'}}" bindtap="submit">提交预约</button>
  </view>
</view>
